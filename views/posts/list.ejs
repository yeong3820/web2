<div class="my-5">
    <h1 class="text-center mb-5">게시판</h1>
    <div class="row">
        <div class="col-8 col-md-6 col-lg-4 md-2">
            <form name="frm" class="input-group">
                <input name="word" class="form-control" placeholder="작성자, 제목, 내용">
                <button class="btn btn-primary">검색</button>
            </form>
        </div> 
        <div class="col text-end">
            <button class="btn btn-link" id="btn-write">글쓰기</button>
        </div>
    </div>
    <table id="tb1" class="table table-bordered talbe-hover"></table>
    <div class="text-center">
        <button class="btn btn-link btn-prev">이전</button>
        <span class="page_info px-3">1/10</span>
        <button class="btn btn-link btn-next">다음</button>
    </div>
    <script id="temp" type="text/x-handlebars-template">
        <thead class="table-center">
            <tr>
                <th>번호</th>
                <th>제목</th>
                <th>작성자</th>
                <th>작성일</th>
            </tr>
        </thead>
        <tbody>
            {{#each .}}
            <tr>
                <td>{{ID}}</td>
                <td><a href="/posts/{{ID}}">{{TITLE}}</a></td>
                <td>{{SNAME}}</td>
                <td>{{FMT_DATE}}</td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>
<script>
    let page=1;
    let size=7;
    let word="";
    getList();

    $("#btn-write").on("click", function(){
        if(scode){
            location.href="/posts/insert";
        }
        else{
            sessionStorage.setItem("target", "posts/insert");
            location.href="/users/login";
        }
    });

    $(frm).on("submit", function(e){
        e.preventDefault();
        word = $(frm.word).val();
        page=1;
        getList();
    });

    $(".btn-prev").on("click", function(){  // 시험 예시
        page--;
        getList();
    });

    $(".btn-next").on("click", function(){  
        page++;
        getList();
    });
                                              
    function getList(){
        $.ajax({
            type:"get",
            url:"/posts/list.json",
            data:{page, size, word},
            success:function(data){
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tb1").html(temp(data.list));

                const last = Math.ceil(data.count/size);
                $(".page_info").html(`${page}/${last}`);  // 페이지 정보 업데이트

                if(page==1) $(".btn-prev").attr("disabled", true);  // 첫 페이지에서는 이전 버튼 비활성화
                else $(".btn-prev").attr("disabled", false);
                if(page==last) $(".btn-next").attr("disabled", true);  // 마지막 페이지에서는 다음 버튼 비활성화
                else $(".btn-next").attr("disabled", false);

                if(last > 1) $("#pagination").show();
                else $("#pagination").hide();
            }
        })
    }

</script>