<div class="my-5">
    <h1 class="text-center mb-5">게시글</h1>
    <table id="tbl" class="table table-striped table-hover"></table>
    
    <div class="text-center">
        <button class="btn btn-primary btn-sm px-3" id="prev">이전</button>
        <span id="page" class="mx-3"></span>
        <button class="btn btn-primary btn-sm px-3" id="next">다음</button>
    </div>

    <script id="temp" type="text/x-handlebars-template">
        <tbody>
        {{#each .}}
        <tr>
            <td>{{ID}}</td>
            <td>{{TITLE}}</td>
            <td>{{SNAME}}({{WRITER}})</td>
            <td class="text-end">{{FMT_DATE}}</td>
         </tr>
        {{/each}}
        </tbody>
    </script>
</div>

<script>
    let page = 1;
    let size = 5; // 수업 시간 규격: 한 페이지에 5개씩 컷
    getList();

    // 다음 버튼 클릭 이벤트
    $("#next").on("click", function(){
        page++;
        getList();
    });

    // 이전 버튼 클릭 이벤트
    $("#prev").on("click", function(){
        page--;
        getList();
    });

    // 데이터 로딩 및 페이징 제어 함수
    function getList(){
        console.log(page, size);
        $.ajax({
            type: "get",
            url: "/posts/list.json",
            data: { page, size },
            success: function(data) {
                console.log(data);
                const temp = Handlebars.compile($("#temp").html());
               
                // 넘겨받은 data 상자 안의 list 배열(.list)을 바로 컨텍스트로 전달
                $("#tbl").html(temp(data.list));
                
                // 전체 개수(total) 기반 마지막 페이지 연산 및 출력
                const last = Math.ceil(data.total / size);
                $("#page").html(`${page}/${last}`);

                // 1페이지에서 이전 버튼을 클릭한 경우 비활성화 예외 처리
                if(page == 1) $("#prev").attr("disabled", true); 
                else $("#prev").attr("disabled", false);
      
                // 마지막 페이지에서 다음 버튼을 클릭한 경우 비활성화 예외 처리
                if(page == last) $("#next").attr("disabled", true); 
                else $("#next").attr("disabled", false);
            }
        });
    }
</script>