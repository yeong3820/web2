<div class="row my-5 justify-content-center">
    <div class="col-md-10">
        <h1 class="text-center mb-4"><%=title%> 목록</h1>
        
        <div class="card p-3 shadow-sm">
            <table class="table table-striped table-hover text-center align-middle">
                <thead>
                    <tr class="table-dark">
                        <th style="width: 10%;">번호</th>
                        <th style="width: 50%;">제목</th>
                        <th style="width: 15%;">작성자</th>
                        <th style="width: 25%;">등록일</th>
                    </tr>
                </thead>
                <tbody id="tbl"></tbody>
            </table>
            
            <div class="d-flex justify-content-center align-items-center my-3">
                <button class="btn btn-outline-primary btn-sm me-3" id="prev">이전</button>
                <span class="fw-bold" id="page">1 / 1</span>
                <button class="btn btn-outline-primary btn-sm ms-3" id="next">다음</button>
            </div>
        </div>
    </div>
</div>

<script id="temp" type="text/x-handlebars-template">
    {{#each list}}
    <tr>
        <td>{{id}}</td>
        <td class="text-start ps-3">
            <a href="#" class="text-decoration-none text-dark fw-semibold">{{title}}</a>
        </td>
        <td>{{sname}} ({{writer}})</td>
        <td>{{fmt_date}}</td>
    </tr>
    {{/each}}
</script>

<script>
    let page = 1;
    const size = 5; // 교수님 레이아웃 사양에 맞춘 한 페이지당 출력 개수

    // 페이지 최초 로드 시 데이터 호출
    getList();

    // [이전] 버튼 클릭 이벤트
    $("#prev").on("click", function() {
        page--;
        getList();
    });

    // [다음] 버튼 클릭 이벤트
    $("#next").on("click", function() {
        page++;
        getList();
    });

    // 서버 API(list.json)로부터 데이터를 비동기로 받아와 테이블을 갱신하는 함수
    function getList() {
        $.ajax({
            type: "get",
            url: "/posts/list.json",
            data: { page: page, size: size },
            success: function(data) {
                console.log("받아온 게시글 데이터:", data);
                
                // (1) Handlebars 템플릿 컴파일 및 데이터 바인딩
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data));
                
                // (2) 전체 개수(total)를 기반으로 마지막 페이지 계산
                const last = Math.ceil(data.total / size) || 1;
                $("#page").html(`${page} / ${last}`);
                
                // (3) 첫 페이지 혹은 마지막 페이지 도달 시 버튼 활성화/비활성화 예외 제어
                if (page === 1) {
                    $("#prev").attr("disabled", true);
                } else {
                    $("#prev").attr("disabled", false);
                }
                
                if (page === last) {
                    $("#next").attr("disabled", true);
                } else {
                    $("#next").attr("disabled", false);
                }
            },
            error: function(err) {
                alert("게시글 데이터를 가져오는 도중 문제가 발생했습니다.");
            }
        });
    }
</script>